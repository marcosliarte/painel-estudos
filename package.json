{
  "name": "painel-de-estudos",
  "version": "1.0.6",
  "description": "Painel de estudos offline (app desktop) com MongoDB local",
  "main": "src/main/main.js",
  "author": "Marcos",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "predist": "npm version patch --no-git-tag-version",
    "dist": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.marcos.paineldeestudos",
    "productName": "Painel de Estudos",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "artifactName": "${productName} Setup ${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
